{
  "name": "front-desk",
  "private": true,
  "version": "0.0.0",
  "description": "A tiny help desk: customer emails become tickets that teammates reply to, tag, assign, and close.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "vendor/*",
    "legacy",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "generate": "npm run generate -w @front-desk/contract",
    "mail:drop": "node legacy/bin/mail-drop.js",
    "rules:parity": "tsx scripts/rules-parity.ts",
    "canary": "tsx scripts/canary.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}

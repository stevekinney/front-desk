{
  "name": "front-desk",
  "private": true,
  "version": "0.0.0",
  "description": "A tiny help desk: customer emails become tickets that teammates reply to, tag, assign, and close.",
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "workspaces": [
    "packages/*",
    "vendor/*",
    "legacy",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "check": "tsx scripts/check.ts",
    "smoke": "tsx scripts/smoke.ts",
    "generate": "npm run generate -w @front-desk/contract",
    "reset": "tsx scripts/reset.ts",
    "mail:drop": "node legacy/bin/mail-drop.js",
    "rules:parity": "tsx scripts/rules-parity.ts",
    "feature:check": "tsx scripts/feature-check.ts",
    "canary": "tsx scripts/canary.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p acceptance/tsconfig.json && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test --config e2e/playwright.config.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
